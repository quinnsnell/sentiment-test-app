# Copy this to `.env` and edit for local development. `.env` is git-ignored.
# For deployed instances, set these values in Coolify's Environment Variables
# tab (never commit real .env files to the repo).

# --- Classroom LiteLLM (LLM path) ---
LITELLM_URL=http://ml-capstone.cs.byu.edu:4000/v1
LITELLM_API_KEY=sk-noauth
MODEL=classroom-chat

# --- Local HF sentiment classifier ---
LOCAL_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest

# --- GPU pinning (uncomment ONE line to control which GPU this container uses) ---
# When set, the container only sees the specified GPU (indexed 0-3 on rigel).
# Recommended convention: N = <your group number> % 4
#   Group1 -> CUDA_VISIBLE_DEVICES=0
#   Group2 -> CUDA_VISIBLE_DEVICES=1
#   Group3 -> CUDA_VISIBLE_DEVICES=2
#   Group4 -> CUDA_VISIBLE_DEVICES=3
#   Group5 -> CUDA_VISIBLE_DEVICES=0   (wraps back around)
# Inside the container, the pinned GPU always appears as cuda:0.
# CUDA_VISIBLE_DEVICES=0

# --- Explicit device override (leave commented to let the app auto-pick) ---
# If unset, the app picks the GPU with the most free VRAM at startup
# (or falls back to CPU if no CUDA available). Set explicitly to force.
# DEVICE=cuda:0

# --- Testing knob ---
# Set to 1 in tests / CI to skip loading the HF model (which needs GPU + download).
# SKIP_LOCAL_MODEL=1
